# Free LLM access. Pick ONE provider and paste its key.
#   groq       (default) free key: https://console.groq.com/keys      open models: gpt-oss-120b, Llama, Qwen
#   nvidia     free key: https://build.nvidia.com  (nvapi-...)          NVIDIA Nemotron and 80+ open models
#   cerebras   free key: https://cloud.cerebras.ai                     open models: gpt-oss-120b, Llama, Qwen
#   openrouter free key: https://openrouter.ai/keys                    many ":free" open models
#   gemini     free key: https://aistudio.google.com/apikey            Gemini Flash (free tier, not open source)
#   ollama     no key, runs locally (needs a strong computer):         https://ollama.com
LLM_PROVIDER=groq
LLM_API_KEY=

# Optional overrides (defaults are in config.json):
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1
